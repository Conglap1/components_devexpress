@inject NavigationManager NavigationManager
@implements IDisposable

<div>
    <DxMenu Orientation="@DevExpress.Blazor.Orientation.Vertical" CssClass="menu">
        <Items>
            <DxMenuItem NavigateUrl="/" Text="Home" CssClass="@MenuItemCssClass("/")" IconCssClass="icon icon-home"></DxMenuItem>
            <DxMenuItem NavigateUrl="/buttons-demo" Text="Buttons Demo" CssClass="@MenuItemCssClass("/buttons-demo")" IconCssClass="icon icon-docs"></DxMenuItem>
            <DxMenuItem NavigateUrl="/text-field-demo" Text="Text Field, Text Area & Combobox" CssClass="@MenuItemCssClass("/text-field-demo")" IconCssClass="icon icon-docs"></DxMenuItem>
            <DxMenuItem NavigateUrl="/segmented-demo" Text="Segmented Demo" CssClass="@MenuItemCssClass("/segmented-demo")" IconCssClass="icon icon-docs"></DxMenuItem>
            <DxMenuItem NavigateUrl="/badge-demo" Text="Badge Demo" CssClass="@MenuItemCssClass("/badge-demo")" IconCssClass="icon icon-docs"></DxMenuItem>
            <DxMenuItem NavigateUrl="/progress-bar-demo" Text="Progress Bar Demo" CssClass="@MenuItemCssClass("/progress-bar-demo")" IconCssClass="icon icon-docs"></DxMenuItem>
            <DxMenuItem NavigateUrl="/checkbox-demo" Text="Checkbox Demo" CssClass="@MenuItemCssClass("/checkbox-demo")" IconCssClass="icon icon-docs"></DxMenuItem>
            <DxMenuItem NavigateUrl="/divider-demo" Text="Divider Demo" CssClass="@MenuItemCssClass("/divider-demo")" IconCssClass="icon icon-docs"></DxMenuItem>
            <DxMenuItem NavigateUrl="/tree-demo" Text="Tree Demo" CssClass="@MenuItemCssClass("/tree-demo")" IconCssClass="icon icon-docs"></DxMenuItem>
            <DxMenuItem NavigateUrl="/dialog-demo" Text="Dialog Demo" CssClass="@MenuItemCssClass("/dialog-demo")" IconCssClass="icon icon-docs"></DxMenuItem>
            <DxMenuItem NavigateUrl="/counter" Text="Counter" CssClass="@MenuItemCssClass("/counter")" IconCssClass="icon icon-counter"></DxMenuItem>
            <DxMenuItem NavigateUrl="/weather" Text="Weather" CssClass="@MenuItemCssClass("/weather")" IconCssClass="icon icon-weather"></DxMenuItem>
        </Items>
    </DxMenu>
</div>

@code {
    private string? currentLocalPath;

    protected override void OnInitialized() {
        currentLocalPath = new Uri(NavigationManager.Uri).LocalPath;
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) {
        currentLocalPath = new Uri(NavigationManager.Uri).LocalPath;
        InvokeAsync(StateHasChanged);
    }

    private string? MenuItemCssClass(string itemPath) {
        return string.Equals(currentLocalPath, itemPath, StringComparison.OrdinalIgnoreCase) ? "menu-item-active" : null;
    }

    public void Dispose() {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}