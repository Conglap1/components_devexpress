@page "/progress-bar-demo"
@namespace Button_Segmented.Client.Pages

<PageTitle>Progress Bar Demo</PageTitle>

<div class="pb-demo">
    <h1 class="pb-demo__title">Progress Bar — Demo</h1>

    <!-- ========== Interactive slider ========== -->
    <section class="pb-demo__section">
        <h2 class="pb-demo__section-title">Interactive controls</h2>
        <div class="pb-demo__card">
            <label class="pb-demo__slider-label" for="pb-slider">Value: <strong>@_value</strong> / @_max</label>
            <div class="pb-demo__slider-row">
                <input id="pb-slider" type="range" min="0" max="@_max" step="1"
                       @bind="_value" @bind:event="oninput" class="pb-demo__slider" />
                <span class="pb-demo__slider-chip">@_value</span>
            </div>
        </div>
    </section>

    <!-- ========== Progress Line ========== -->
    <section class="pb-demo__section">
        <h2 class="pb-demo__section-title">Progress Line</h2>
        <div class="pb-demo__card">
            <div class="pb-demo__line-list">
                <div class="pb-demo__line-row">
                    <span class="pb-demo__size-label">md</span>
                    <div class="pb-demo__line-bar">
                        <HqProgressLine Value="@_value" Max="@_max"
                                        Size="HqProgressLineSize.Md"
                                        Status="@CurrentStatus"
                                        ShowInfo="true"
                                        Description="Description"
                                        Label="@($"{_value}%")" />
                    </div>
                </div>
                <div class="pb-demo__line-row">
                    <span class="pb-demo__size-label">sm</span>
                    <div class="pb-demo__line-bar">
                        <HqProgressLine Value="@_value" Max="@_max"
                                        Size="HqProgressLineSize.Sm"
                                        Status="@CurrentStatus"
                                        ShowInfo="true"
                                        Description="Description"
                                        Label="@($"{_value}%")" />
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ========== Progress KPI ========== -->
    <section class="pb-demo__section">
        <h2 class="pb-demo__section-title">Progress KPI</h2>
        <div class="pb-demo__card">
            <div class="pb-demo__kpi-row">
                <div class="pb-demo__kpi-item">
                    <span class="pb-demo__size-label">Circle</span>
                    <HqProgressKpi Type="HqProgressKpiType.Circle"
                                   Status="@CurrentStatus"
                                   Value="@_value"
                                   Max="@_max"
                                   Description="Description" />
                </div>
                <div class="pb-demo__kpi-item">
                    <span class="pb-demo__size-label">Line</span>
                    <HqProgressKpi Type="HqProgressKpiType.Line"
                                   Status="@CurrentStatus"
                                   Value="@_value"
                                   Max="@_max"
                                   Description="Description" />
                </div>
            </div>
        </div>
    </section>

    <!-- ========== Progress Circle — sizes ========== -->
    <section class="pb-demo__section">
        <h2 class="pb-demo__section-title">Progress Circle — sizes</h2>
        <div class="pb-demo__card">
            <div class="pb-demo__circle-row">
                <div class="pb-demo__circle-item">
                    <HqProgressCircle Type="HqProgressCircleType.Label" Size="HqProgressCircleSize.Sm" Progress="@_value" />
                    <span class="pb-demo__size-label">sm</span>
                </div>
                <div class="pb-demo__circle-item">
                    <HqProgressCircle Type="HqProgressCircleType.Label" Size="HqProgressCircleSize.Md" Progress="@_value" />
                    <span class="pb-demo__size-label">md</span>
                </div>
                <div class="pb-demo__circle-item">
                    <HqProgressCircle Type="HqProgressCircleType.Label" Size="HqProgressCircleSize.Lg" Progress="@_value" />
                    <span class="pb-demo__size-label">lg</span>
                </div>
                <div class="pb-demo__circle-item">
                    <HqProgressCircle Type="HqProgressCircleType.Label" Size="HqProgressCircleSize.Xl" Progress="@_value" />
                    <span class="pb-demo__size-label">xl</span>
                </div>
                <div class="pb-demo__circle-item">
                    <HqProgressCircle Type="HqProgressCircleType.Icon" Size="HqProgressCircleSize.Md" Progress="@_value" IconCssClass="fa-solid fa-chart-simple" />
                    <span class="pb-demo__size-label">icon</span>
                </div>
            </div>
        </div>
    </section>
</div>

@code {
    private int _value = 50;
    private int _max = 100;

    private HqProgressStatus CurrentStatus => _value switch
    {
        > 80 => HqProgressStatus.Positive,
        > 50 => HqProgressStatus.Careful,
        > 40 => HqProgressStatus.Stressful,
        _ => HqProgressStatus.Default
    };
}
