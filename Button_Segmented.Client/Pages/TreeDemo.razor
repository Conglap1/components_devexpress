@page "/tree-demo"
@namespace Button_Segmented.Client.Pages

<PageTitle>Tree Demo</PageTitle>

<h2 class="demo-title">Tree Demo</h2>
<p class="demo-subtitle">HqTreeView — Wraps DxTreeView with HQSOFT Design System styling.</p>

@* ===== Section 1: Checkbox mode (no icons) ===== *@
<section class="demo-section">
    <h3 class="demo-section-title">Checkbox mode (no icons)</h3>
    <p class="demo-section-desc">Matches popup tree usage in Companies → Geography / SalesChannel selection.</p>

    <div class="demo-card">
        <HqTreeView Data="@_geographyData"
                     ShowCheckboxes="true"
                     IconMode="HqTreeIconMode.None" />
    </div>
</section>

@* ===== Section 2: Folder icon mode ===== *@
<section class="demo-section">
    <h3 class="demo-section-title">Folder icon mode</h3>
    <p class="demo-section-desc">Each node shows folder (collapsed) / folder-open (expanded) / file-data (leaf) icon.</p>

    <div class="demo-card">
        <HqTreeView Data="@_salesChannelData"
                     ShowCheckboxes="true"
                     IconMode="HqTreeIconMode.Folder" />
    </div>
</section>

@* ===== Section 3: No checkboxes — selectable ===== *@
<section class="demo-section">
    <h3 class="demo-section-title">Selection mode (no checkboxes)</h3>
    <p class="demo-section-desc">Navigation tree: click to select, no checkboxes. Matches sidebar tree usage.</p>

    <div class="demo-card">
        <HqTreeView Data="@_companyTreeData"
                     ShowCheckboxes="false"
                     AllowSelectNodes="true"
                     IconMode="HqTreeIconMode.Folder" />
    </div>
</section>

@* ===== Section 4: Disabled items ===== *@
<section class="demo-section">
    <h3 class="demo-section-title">Disabled items</h3>
    <p class="demo-section-desc">Some nodes are disabled (non-interactive, grayed out).</p>

    <div class="demo-card">
        <HqTreeView Data="@_disabledData"
                     ShowCheckboxes="true"
                     IconMode="HqTreeIconMode.Folder" />
    </div>
</section>

