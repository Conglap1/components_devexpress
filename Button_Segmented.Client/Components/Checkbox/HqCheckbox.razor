@namespace Button_Segmented.Client.Components.Checkbox

<label class="@ShellClass" for="@InputId" style="@Style">
    <DxCheckBox CssClass="@RootClass"
                Checked="@CurrentCheckedState"
                CheckedChanged="@CheckedChangedCallback"
                Enabled="@(!Disabled)"
                AllowIndeterminateState="@Indeterminate"
                AllowIndeterminateStateByClick="false"
                DisableDefaultRender="true"
                InputId="@InputId"
                Attributes="@EffectiveAttributes">
        <span class="hq-checkbox__icon" aria-hidden="true">
            <i class="@IconCssClass"></i>
        </span>
    </DxCheckBox>

    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <span class="hq-checkbox__label">@Label</span>
    }
    else if (ChildContent is not null)
    {
        <span class="hq-checkbox__label">@ChildContent</span>
    }
</label>

@code {
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }
    [Parameter] public bool Value { get; set; }
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }
    [Parameter] public bool Indeterminate { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public HqCheckboxSize Size { get; set; } = HqCheckboxSize.Md;
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }

    private bool _internalValue;
    private bool _isControlled;
    private string InputId { get; } = $"hq-checkbox-{Guid.NewGuid():N}";

    private bool CurrentValue => _isControlled ? Value : _internalValue;
    private bool? CurrentCheckedState => Indeterminate ? null : CurrentValue;
    private EventCallback<bool?> CheckedChangedCallback => EventCallback.Factory.Create<bool?>(this, HandleCheckedChanged);
    private Dictionary<string, object> EffectiveAttributes => AdditionalAttributes ?? new Dictionary<string, object>();
    private string ShellClass => string.Join(" ", new[] { "hq-checkbox-shell", Disabled ? "is-disabled" : null, Class }.Where(c => !string.IsNullOrWhiteSpace(c)));
    private string IconCssClass => string.Join(" ", new[]
    {
        "hq-checkbox__glyph",
        Size switch
        {
            HqCheckboxSize.Xs => "hq-checkbox__glyph--xs",
            HqCheckboxSize.Sm => "hq-checkbox__glyph--sm",
            _ => "hq-checkbox__glyph--md"
        },
        Indeterminate ? "fa-solid fa-square-minus" : CurrentValue ? "fa-solid fa-square-check" : "fa-regular fa-square"
    });

    protected override void OnParametersSet()
    {
        _isControlled = ValueChanged.HasDelegate;
        if (_isControlled)
        {
            _internalValue = Value;
        }
    }

    protected override void OnInitialized()
    {
        _internalValue = Value;
    }

    private string RootClass => string.Join(" ",
        new[]
        {
            "hq-checkbox",
            $"hq-checkbox--{Size.ToString().ToLowerInvariant()}",
            Disabled ? "is-disabled" : null,
            CurrentValue && !Indeterminate ? "is-checked" : null,
            Indeterminate ? "is-indeterminate" : null,
            null
        }.Where(c => !string.IsNullOrWhiteSpace(c)));

    private async Task HandleCheckedChanged(bool? checkedState)
    {
        if (Disabled)
        {
            return;
        }

        var newValue = checkedState ?? false;

        if (_isControlled)
        {
            await ValueChanged.InvokeAsync(newValue);
        }
        else
        {
            _internalValue = newValue;
        }

        Indeterminate = false;
    }
}
