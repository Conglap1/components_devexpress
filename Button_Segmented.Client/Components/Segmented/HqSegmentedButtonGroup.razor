@namespace Button_Segmented.Client.Components.Segmented

<HqSegmentedControl AriaLabel="@AriaLabel"
                    Items="@Items"
                    SelectedIndex="@SelectedIndex"
                    SelectedIndexChanged="@SelectedIndexChanged"
                    Size="@Size"
                    FullWidth="@FullWidth"
                    Disabled="@Disabled" />

@code {
    [Parameter] public string AriaLabel { get; set; } = "Segmented button group";
    [Parameter] public List<HqSegmentedItem> Items { get; set; } = [];
    [Parameter] public int SelectedIndex { get; set; }
    [Parameter] public EventCallback<int> SelectedIndexChanged { get; set; }
    [Parameter] public HqButtonSize Size { get; set; } = HqButtonSize.Md;
    [Parameter] public bool FullWidth { get; set; }
    [Parameter] public bool Disabled { get; set; }
}
