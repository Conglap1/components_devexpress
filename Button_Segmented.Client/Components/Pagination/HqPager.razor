@namespace Button_Segmented.Client.Components.Pagination

<div class="@RootCssClass" style="@Style">
    @if (PagerStyle == HqPagerStyle.Style1)
    {
        @* Style-1: Navigation on LEFT, Page size + info on RIGHT *@
        <div class="hq-pager__left">
            <DxPager PageCount="@PageCount"
                     ActivePageIndex="@ActivePageIndex"
                     ActivePageIndexChanged="@HandlePageIndexChanged"
                     VisibleNumericButtonCount="@VisibleNumericButtonCount"
                     NavigationMode="PagerNavigationMode.NumericButtons"
                     CssClass="@DxPagerCssClass" />
        </div>
        <div class="hq-pager__right">
            @if (ShowPageSize)
            {
                <button class="hq-pager__page-size-btn" @onclick="TogglePageSizeDropdown" @onclick:stopPropagation="true">
                    <span>@PageSize</span>
                    <span class="icon icon-chevron-down hq-pager__page-size-icon"></span>
                </button>
                @if (_showPageSizeDropdown)
                {
                    <div class="hq-pager__page-size-dropdown">
                        @foreach (var size in PageSizeOptions)
                        {
                            <button class="hq-pager__page-size-option @(size == PageSize ? "is-selected" : "")"
                                    @onclick="() => SelectPageSize(size)"
                                    @onclick:stopPropagation="true">
                                @size
                            </button>
                        }
                    </div>
                }
            }
            @if (ShowInfo)
            {
                <span class="hq-pager__info-text">Showing @FirstItemIndex-@LastItemIndex on @TotalItemCount items</span>
            }
        </div>
    }
    else
    {
        @* Style-2: Page size + info on LEFT, Navigation on RIGHT *@
        <div class="hq-pager__left">
            @if (ShowPageSize)
            {
                <span class="hq-pager__info-text">Page size</span>
                <button class="hq-pager__page-size-btn" @onclick="TogglePageSizeDropdown" @onclick:stopPropagation="true">
                    <span>@PageSize</span>
                    <span class="icon icon-chevron-down hq-pager__page-size-icon"></span>
                </button>
                @if (_showPageSizeDropdown)
                {
                    <div class="hq-pager__page-size-dropdown">
                        @foreach (var size in PageSizeOptions)
                        {
                            <button class="hq-pager__page-size-option @(size == PageSize ? "is-selected" : "")"
                                    @onclick="() => SelectPageSize(size)"
                                    @onclick:stopPropagation="true">
                                @size
                            </button>
                        }
                    </div>
                }
            }
            @if (ShowInfo)
            {
                <span class="hq-pager__info-text">Showing @FirstItemIndex-@LastItemIndex on @TotalItemCount items</span>
            }
        </div>
        <div class="hq-pager__right">
            <DxPager PageCount="@PageCount"
                     ActivePageIndex="@ActivePageIndex"
                     ActivePageIndexChanged="@HandlePageIndexChanged"
                     VisibleNumericButtonCount="@VisibleNumericButtonCount"
                     NavigationMode="PagerNavigationMode.InputBox"
                     CssClass="@DxPagerCssClass" />
        </div>
    }
</div>

@code {
    [Parameter] public int PageCount { get; set; } = 10;
    [Parameter] public int ActivePageIndex { get; set; } = 0;
    [Parameter] public EventCallback<int> ActivePageIndexChanged { get; set; }
    [Parameter] public int VisibleNumericButtonCount { get; set; } = 5;
    [Parameter] public HqPagerStyle PagerStyle { get; set; } = HqPagerStyle.Style1;
    [Parameter] public HqPagerSize Size { get; set; } = HqPagerSize.Md;
    [Parameter] public bool ShowPageSize { get; set; } = true;
    [Parameter] public bool ShowInfo { get; set; } = true;
    [Parameter] public int PageSize { get; set; } = 10;
    [Parameter] public EventCallback<int> PageSizeChanged { get; set; }
    [Parameter] public int[] PageSizeOptions { get; set; } = [5, 10, 20, 50];
    [Parameter] public int TotalItemCount { get; set; } = 95;
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }

    private bool _showPageSizeDropdown;

    private int FirstItemIndex => ActivePageIndex * PageSize + 1;
    private int LastItemIndex => Math.Min((ActivePageIndex + 1) * PageSize, TotalItemCount);

    private string RootCssClass => string.Join(" ",
        "hq-pager",
        $"hq-pager--{Size.ToString().ToLowerInvariant()}",
        $"hq-pager--{PagerStyle.ToString().ToLowerInvariant().Replace("style", "style-")}",
        Class).Trim();

    private string DxPagerCssClass => "hq-pager__dx";

    private async Task HandlePageIndexChanged(int newIndex)
    {
        ActivePageIndex = newIndex;
        await ActivePageIndexChanged.InvokeAsync(newIndex);
    }

    private void TogglePageSizeDropdown()
    {
        _showPageSizeDropdown = !_showPageSizeDropdown;
    }

    private async Task SelectPageSize(int size)
    {
        _showPageSizeDropdown = false;
        if (size == PageSize) return;
        PageSize = size;
        ActivePageIndex = 0;
        await PageSizeChanged.InvokeAsync(PageSize);
        await ActivePageIndexChanged.InvokeAsync(ActivePageIndex);
    }
}
