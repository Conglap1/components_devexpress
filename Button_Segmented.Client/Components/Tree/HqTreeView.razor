@namespace Button_Segmented.Client.Components.Tree

<div class="@RootCssClass" style="@Style">
    @if (ShowCheckboxes)
    {
        <DxTreeView Data="@Data"
                    CheckMode="TreeViewCheckMode.Recursive"
                    CheckNodeByClick="@CheckNodeByClick"
                    CheckedChanged="OnCheckedChanged"
                    AnimationType="LayoutAnimationType.Slide"
                    CssClass="hq-tree__dx">
            <DataMappings>
                <DxTreeViewDataMapping Children="Children"
                                       Text="Text" />
            </DataMappings>
            <NodeTextTemplate Context="nodeCtx">
                @NodeContent((HqTreeNode)nodeCtx.DataItem)
            </NodeTextTemplate>
        </DxTreeView>
    }
    else
    {
        <DxTreeView Data="@Data"
                    AllowSelectNodes="@AllowSelectNodes"
                    SelectionChanged="OnSelectionChanged"
                    AnimationType="LayoutAnimationType.Slide"
                    CssClass="hq-tree__dx">
            <DataMappings>
                <DxTreeViewDataMapping Children="Children"
                                       Text="Text" />
            </DataMappings>
            <NodeTextTemplate Context="nodeCtx">
                @NodeContent((HqTreeNode)nodeCtx.DataItem)
            </NodeTextTemplate>
        </DxTreeView>
    }
</div>

@code {
    [Parameter] public IEnumerable<HqTreeNode>? Data { get; set; }
    [Parameter] public bool ShowCheckboxes { get; set; } = true;
    [Parameter] public bool CheckNodeByClick { get; set; }
    [Parameter] public bool AllowSelectNodes { get; set; }
    [Parameter] public HqTreeIconMode IconMode { get; set; } = HqTreeIconMode.None;
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter] public EventCallback<HqTreeNode?> SelectedValueChanged { get; set; }
    [Parameter] public EventCallback<IReadOnlyCollection<HqTreeNode>> SelectedValuesChanged { get; set; }

    private RenderFragment NodeContent(HqTreeNode dataItem) => __builder =>
    {
        <div class="hq-tree-item__content">
            @if (IconMode == HqTreeIconMode.Folder)
            {
                @if (dataItem.IsParent)
                {
                    <span class="hq-tree-item__icon hq-tree-item__icon--folder" aria-hidden="true">
                        <i class="fa-solid fa-folder"></i>
                    </span>
                }
                else
                {
                    <span class="hq-tree-item__icon hq-tree-item__icon--file" aria-hidden="true">
                        <i class="fa-solid fa-file"></i>
                    </span>
                }
            }
            else if (IconMode == HqTreeIconMode.Custom && !string.IsNullOrEmpty(dataItem.IconCssClass))
            {
                <span class="hq-tree-item__icon hq-tree-item__icon--custom" aria-hidden="true">
                    <i class="@dataItem.IconCssClass"></i>
                </span>
            }
            <span class="hq-tree-item__text">@dataItem.Text</span>
        </div>
    };

    private string RootCssClass => string.Join(" ",
        new[]
        {
            "hq-tree",
            IconMode != HqTreeIconMode.None ? "hq-tree--has-icon" : null,
            ShowCheckboxes ? "hq-tree--has-checkbox" : null,
            CheckNodeByClick ? "hq-tree--check-by-click" : null,
            AllowSelectNodes && !ShowCheckboxes ? "hq-tree--selectable" : null,
            Class
        }.Where(c => !string.IsNullOrWhiteSpace(c)));

    private async Task OnSelectionChanged(TreeViewNodeEventArgs e)
    {
        var node = e.NodeInfo?.DataItem as HqTreeNode;
        await SelectedValueChanged.InvokeAsync(node);
    }

    private async Task OnCheckedChanged(TreeViewCheckedChangedEventArgs e)
    {
        var nodes = e.CheckedItems?.Cast<HqTreeNode>().ToList().AsReadOnly()
                    ?? (IReadOnlyCollection<HqTreeNode>)Array.Empty<HqTreeNode>();
        await SelectedValuesChanged.InvokeAsync(nodes);
    }
}
