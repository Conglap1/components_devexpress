@namespace Button_Segmented.Client.Components.Buttons

<div class="@($"hq-segmented hq-segmented--{Size.ToString().ToLowerInvariant()}")" role="group" aria-label="@AriaLabel">
    @for (var i = 0; i < Items.Count; i++)
    {
        var index = i;
        var isActive = index == SelectedIndex;
        var item = Items[i];

        <HqButton Text="@item.Text"
                  IconCssClass="@item.IconCssClass"
                  IconOnly="false"
                  Size="@MappedButtonSize"
                  Shape="HqButtonShape.RoundedMedium"
                  Variant="@(isActive ? HqButtonVariant.Primary : HqButtonVariant.Outline)"
                  State="@(item.Disabled ? HqButtonVisualState.Disabled : HqButtonVisualState.Enabled)"
                  Class="hq-segmented__button"
                  Click="@(() => OnItemClick(index))" />
    }
</div>

@code {
    [Parameter] public string AriaLabel { get; set; } = "Segmented button group";
    [Parameter] public List<HqSegmentedItem> Items { get; set; } = [];
    [Parameter] public int SelectedIndex { get; set; }
    [Parameter] public EventCallback<int> SelectedIndexChanged { get; set; }
    [Parameter] public HqButtonSize Size { get; set; } = HqButtonSize.Md;

    private HqButtonSize MappedButtonSize => Size switch
    {
        HqButtonSize.Md => HqButtonSize.Sm,
        HqButtonSize.Sm => HqButtonSize.Xs,
        _ => HqButtonSize.Xs
    };

    private async Task OnItemClick(int index)
    {
        if (index < 0 || index >= Items.Count || Items[index].Disabled || index == SelectedIndex)
        {
            return;
        }

        SelectedIndex = index;
        await SelectedIndexChanged.InvokeAsync(SelectedIndex);
    }
}
