@namespace Button_Segmented.Client.Components.Buttons

<div class="@RootClass" role="group" aria-label="@AriaLabel">
    @for (var i = 0; i < Items.Count; i++)
    {
        var index = i;
        var isSelected = index == SelectedIndex;
        var item = Items[i];
        var leadingIcon = GetLeadingIconCssClass(item);
        var trailingIcon = GetTrailingIconCssClass(item);

        <button type="button"
                class="@ItemClass(isSelected)"
                disabled="@item.Disabled"
                aria-pressed="@isSelected"
                @onclick="() => OnItemClick(index)">
            @if (!string.IsNullOrWhiteSpace(leadingIcon))
            {
                <span class="icon hq-segmented-control__icon hq-segmented-control__icon--leading @leadingIcon" aria-hidden="true"></span>
            }

            <span class="hq-segmented-control__text">@item.Text</span>

            @if (!string.IsNullOrWhiteSpace(trailingIcon))
            {
                <span class="icon hq-segmented-control__icon hq-segmented-control__icon--trailing @trailingIcon" aria-hidden="true"></span>
            }
        </button>
    }
</div>

@code {
    [Parameter] public string AriaLabel { get; set; } = "Segmented control";
    [Parameter] public List<HqSegmentedItem> Items { get; set; } = [];
    [Parameter] public int SelectedIndex { get; set; }
    [Parameter] public EventCallback<int> SelectedIndexChanged { get; set; }
    [Parameter] public HqButtonSize Size { get; set; } = HqButtonSize.Md;

    private string RootClass => $"hq-segmented-control hq-segmented-control--{Size.ToString().ToLowerInvariant()}";

    private string ItemClass(bool isSelected) =>
        $"hq-segmented-control__item {(isSelected ? "is-selected" : null)}";

    private static string? GetLeadingIconCssClass(HqSegmentedItem item) =>
        !string.IsNullOrWhiteSpace(item.LeadingIconCssClass)
            ? item.LeadingIconCssClass
            : item.IconCssClass;

    private static string? GetTrailingIconCssClass(HqSegmentedItem item) =>
        item.TrailingIconCssClass;

    private async Task OnItemClick(int index)
    {
        if (index < 0 || index >= Items.Count || Items[index].Disabled || index == SelectedIndex)
        {
            return;
        }

        SelectedIndex = index;
        await SelectedIndexChanged.InvokeAsync(index);
    }
}
