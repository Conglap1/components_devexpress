@namespace Button_Segmented.Client.Components.Notification

@* HqNotification — visual-only component dùng để static preview trong demo.
   Actual toast được render bởi DxToastProvider qua HqNotificationService. *@
<div class="@RootClass" role="alert" aria-live="assertive" style="@Style">
    @if (HasLeadingIcon)
    {
        <div class="hq-notif__icon" aria-hidden="true">
            <i class="@IconClass"></i>
        </div>
    }

    <div class="hq-notif__content">
        <div class="hq-notif__text">
            <p class="hq-notif__heading">@Heading</p>
            @if (!string.IsNullOrEmpty(Description))
            {
                <p class="hq-notif__description">@Description</p>
            }
        </div>
        @if (!string.IsNullOrEmpty(ActionText))
        {
            <div class="hq-notif__action">
                <HqButton Text="@ActionText"
                          Variant="HqButtonVariant.Primary"
                          Size="HqButtonSize.Sm"
                          Shape="HqButtonShape.RoundedMedium"
                          Click="HandleAction" />
            </div>
        }
    </div>

    @if (HasCloseButton)
    {
        <button class="hq-notif__close" type="button" aria-label="Đóng" @onclick="HandleClose">
            <i class="fa-light fa-xmark" aria-hidden="true"></i>
        </button>
    }
</div>

@code {
    [Parameter] public HqNotificationType Type { get; set; } = HqNotificationType.Default;
    [Parameter] public string Heading { get; set; } = string.Empty;
    [Parameter] public string? Description { get; set; }
    [Parameter] public bool HasLeadingIcon { get; set; } = true;
    [Parameter] public bool HasCloseButton { get; set; } = true;
    [Parameter] public string? ActionText { get; set; }
    [Parameter] public EventCallback OnAction { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }

    private string RootClass => string.Join(" ",
        "hq-notif",
        $"hq-notif--{Type.ToString().ToLowerInvariant()}",
        Class).Trim();

    private string IconClass => Type switch
    {
        HqNotificationType.Positive  => "fa-solid fa-circle-check",
        HqNotificationType.Stressful => "fa-solid fa-circle-exclamation",
        HqNotificationType.Careful   => "fa-solid fa-triangle-exclamation",
        HqNotificationType.Useful    => "fa-solid fa-circle-info",
        _                            => "fa-regular fa-bell"
    };

    private async Task HandleAction() => await OnAction.InvokeAsync();
    private async Task HandleClose() => await OnClose.InvokeAsync();
}
